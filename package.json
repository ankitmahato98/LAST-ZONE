{
  "name": "last-zone",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "LAST ZONE - a single-player 3D battle royale built with Three.js. Combat prototype, shipped as a web game and as a signed Android APK.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "android:add": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:assemble": "cd android && ./gradlew assembleDebug",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleRelease"
  },
  "keywords": [
    "threejs",
    "game",
    "battle-royale",
    "webgl"
  ],
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.9",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.6.9",
    "jsdom": "^30.1.1",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=20.19"
  }
}
