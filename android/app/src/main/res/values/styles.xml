<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Application theme.

        Capacitor's BridgeActivity switches the activity to AppTheme.NoActionBar
        in onCreate, so that style is where a fullscreen game window belongs:
        no action bar, no title, dark background that matches the WebView, and a
        translucent status/navigation bar (the system bars are hidden at runtime
        by MainActivity for an immersive, edge-to-edge game surface).
    -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/lastzone_background</item>
        <item name="android:statusBarColor">@color/lastzone_system_bar</item>
        <item name="android:navigationBarColor">@color/lastzone_system_bar</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Applied by BridgeActivity.onCreate; also the post-splash theme. -->
    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/lastzone_background</item>
    </style>

    <!-- Launch theme: Android 12+ splash screen, then straight into the game. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/lastzone_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">200</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <!-- Pre-Android 12 fallback background -->
        <item name="android:windowBackground">@color/lastzone_background</item>
    </style>
</resources>
